import SchubertForwardStability.StrongMixing.Coefficients.Basic
import Mathlib.Data.PNat.Basic

/-! # Constant extensions and boundary sigma-algebras

## Main results

* `finiteMixingCoeff_const_indep`: finite-row coefficients do not depend on the added constant.
* `generatedSigma_ext_outside`: coordinates wholly outside the row generate a trivial sigma-algebra.

## Main definitions

* `positiveExtension`: extend a positive-indexed sequence by a constant at nonpositive times.
-/

open MeasureTheory

namespace StrongMixing

/-- Changing the added constant does not change any sigma-algebra generated by a finite row's
constant extension. -/
theorem generatedSigma_ext_const_eq {N : ℕ} {Ω E : Type*} [MeasurableSpace E]
    (X : Fin (N + 1) → Ω → E) (x y : E) (s : Set ℤ) :
    generatedSigma (constantExtension X x) s = generatedSigma (constantExtension X y) s := by
  have hcoord (i : ℤ) : MeasurableSpace.comap (constantExtension X x i) inferInstance =
      MeasurableSpace.comap (constantExtension X y i) inferInstance := by
    by_cases hi : 0 ≤ i ∧ i < (N + 1 : ℤ)
    · have heq : constantExtension X x i = constantExtension X y i := by
        funext ω
        simp [constantExtension, hi]
      rw [heq]
    · have hx : constantExtension X x i = fun _ ↦ x := by
        funext ω
        simp [constantExtension, hi]
      have hy : constantExtension X y i = fun _ ↦ y := by
        funext ω
        simp [constantExtension, hi]
      rw [hx, hy, MeasurableSpace.comap_const, MeasurableSpace.comap_const]
  unfold generatedSigma
  exact iSup_congr (fun i ↦ hcoord i)

/-- The finite-row Rosenblatt coefficients are independent of the chosen outside constant. -/
theorem finiteMixingCoeff_const_indep {N : ℕ} {Ω E : Type*}
    [MeasurableSpace Ω] [MeasurableSpace E] (μ : Measure Ω)
    (X : Fin (N + 1) → Ω → E) (x y : E) (h : ℕ) :
    finiteMixingCoeff μ X x h = finiteMixingCoeff μ X y h := by
  simp only [finiteMixingCoeff, mixingCoeff, generatedSigma_ext_const_eq X x y]

/-- A selected coordinate set outside the finite row generates the trivial sigma-algebra. -/
theorem generatedSigma_ext_outside {N : ℕ} {Ω E : Type*} [MeasurableSpace E]
    (X : Fin (N + 1) → Ω → E) (x : E) (s : Set ℤ)
    (hs : ∀ i ∈ s, ¬(0 ≤ i ∧ i < (N + 1 : ℤ))) :
    generatedSigma (constantExtension X x) s = ⊥ := by
  apply iSup_eq_bot.mpr
  intro i
  have heq : constantExtension X x i = fun _ ↦ x := by
    funext ω
    simp [constantExtension, hs i i.property]
  exact heq ▸ MeasurableSpace.comap_const x

/-- Extend a positive-indexed sequence by the fixed constant at all nonpositive times. -/
def positiveExtension {Ω E : Type*} (X : ℕ+ → Ω → E) (xStar : E) (i : ℤ) (ω : Ω) : E :=
  if hi : 0 < i then X ⟨i.toNat, by omega⟩ ω else xStar

end StrongMixing
