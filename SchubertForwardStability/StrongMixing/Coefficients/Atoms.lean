import SchubertForwardStability.StrongMixing.Coefficients.Generated

/-! # Generated sigma-algebras on finite sample spaces

## Main results

* `measurableSet_comap_fibers`: measurable events are unions of attained-value fibers.
* `generatedSigma_fibers`: the joint-coordinate version of this characterization.
* `generatedSigma_comp_finite_le`: arbitrary maps on finite attained values contract sigma-algebras.
-/

open MeasureTheory

namespace StrongMixing

/-- The sigma-algebra generated by selected coordinates is the pullback by their joint vector. -/
theorem generatedSigma_eq_comap {ι Ω E : Type*} [MeasurableSpace E]
    (X : ι → Ω → E) (s : Set ι) :
    generatedSigma X s = MeasurableSpace.comap (fun ω ↦ fun i : s ↦ X i ω) inferInstance := by
  simp only [generatedSigma, MeasurableSpace.pi, MeasurableSpace.comap_iSup,
    MeasurableSpace.comap_comp, Function.comp_def]

/-- On a finite domain with measurable target singletons, a pullback event is measurable
exactly when membership is constant on fibers of the generating function. -/
theorem measurableSet_comap_fibers {Ω E : Type*} [Finite Ω] [MeasurableSpace E]
    [MeasurableSingletonClass E] (f : Ω → E) (A : Set Ω) :
    MeasurableSet[MeasurableSpace.comap f inferInstance] A ↔
      ∀ ω ω', f ω = f ω' → (ω ∈ A ↔ ω' ∈ A) := by
  rw [MeasurableSpace.measurableSet_comap]
  constructor
  · rintro ⟨B, _, rfl⟩ ω ω' h
    change f ω ∈ B ↔ f ω' ∈ B
    rw [h]
  · intro h
    refine ⟨f '' A, ((Set.toFinite A).image f).measurableSet, ?_⟩
    ext ω
    constructor
    · rintro ⟨ω', hω', heq⟩
      exact (h ω' ω heq).mp hω'
    · intro hω
      exact ⟨ω, hω, rfl⟩

/-- On a finite sample space, finitely many coordinates generate exactly the unions of
their joint-value fibers, with no ambient measurability requirement on the coordinates. -/
theorem generatedSigma_fibers {ι Ω E : Type*} [Finite ι] [Finite Ω]
    [MeasurableSpace E] [MeasurableSingletonClass E]
    (X : ι → Ω → E) (s : Set ι) (A : Set Ω) :
    MeasurableSet[generatedSigma X s] A ↔
      ∀ ω ω', (∀ i ∈ s, X i ω = X i ω') → (ω ∈ A ↔ ω' ∈ A) := by
  rw [generatedSigma_eq_comap, measurableSet_comap_fibers]
  constructor
  · intro h ω ω' heq
    exact h ω ω' (funext fun i ↦ heq i i.property)
  · intro h ω ω' heq
    exact h ω ω' (fun i hi ↦ congrFun heq ⟨i, hi⟩)

/-- On a finite sample space, arbitrary maps on attained values contract pullback
sigma-algebras when the original target has measurable singletons. -/
theorem comap_comp_finite_le {Ω E F : Type*} [Finite Ω] [MeasurableSpace E]
    [MeasurableSingletonClass E] [MeasurableSpace F] (X : Ω → E) (g : E → F) :
    MeasurableSpace.comap (fun ω ↦ g (X ω)) inferInstance ≤
      MeasurableSpace.comap X inferInstance := by
  intro A hA
  obtain ⟨B, _, hB⟩ := MeasurableSpace.measurableSet_comap.mp hA
  rw [measurableSet_comap_fibers]
  intro ω ω' heq
  rw [← hB]
  change g (X ω) ∈ B ↔ g (X ω') ∈ B
  rw [heq]

/-- Arbitrary coordinate maps on finite sample spaces do not enlarge generated
sigma-algebras, even for infinitely many coordinates; no global measurability is needed. -/
theorem generatedSigma_comp_finite_le {ι Ω E F : Type*} [Finite Ω]
    [MeasurableSpace E] [MeasurableSingletonClass E] [MeasurableSpace F]
    (X : ι → Ω → E) (g : ι → E → F) (s : Set ι) :
    generatedSigma (fun i ω ↦ g i (X i ω)) s ≤ generatedSigma X s := by
  unfold generatedSigma
  exact iSup_mono fun i ↦ comap_comp_finite_le (X i) (g i)

end StrongMixing
