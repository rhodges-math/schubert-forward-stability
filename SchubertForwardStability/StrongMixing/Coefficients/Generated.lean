import Mathlib.MeasureTheory.MeasurableSpace.Constructions
import Lean.Elab.Tactic.Omega

/-! # Sigma-algebras generated by coordinates

## Main definitions

* `generatedSigma`: the smallest sigma-algebra making a selected family of coordinates measurable.
* `constantExtension`: the constant extension of a finite row to integer times.

## Main results

Generated sigma-algebras are monotone in the coordinate set and contract under measurable
coordinatewise transformations. Deterministic coordinates generate the trivial sigma-algebra.
-/

open MeasureTheory

namespace StrongMixing

/-- The sigma-algebra generated by coordinates with indices in `s`. -/
@[instance_reducible]
noncomputable def generatedSigma {ι Ω E : Type*} [MeasurableSpace E]
    (X : ι → Ω → E) (s : Set ι) : MeasurableSpace Ω :=
  ⨆ i : s, MeasurableSpace.comap (X i) inferInstance

/-- A selected coordinate's generated sigma-algebra lies in that of the selected family. -/
theorem comap_le_generatedSigma {ι Ω E : Type*} [MeasurableSpace E]
    (X : ι → Ω → E) {s : Set ι} {i : ι} (hi : i ∈ s) :
    MeasurableSpace.comap (X i) inferInstance ≤ generatedSigma X s :=
  le_iSup_of_le ⟨i, hi⟩ le_rfl

/-- Enlarging the selected coordinate set enlarges the generated sigma-algebra. -/
theorem generatedSigma_mono {ι Ω E : Type*} [MeasurableSpace E]
    (X : ι → Ω → E) {s t : Set ι} (hst : s ⊆ t) :
    generatedSigma X s ≤ generatedSigma X t :=
  iSup_le (fun i ↦ comap_le_generatedSigma X (hst i.property))

/-- Measurable selected coordinates generate a sub-sigma-algebra of the ambient one. -/
theorem generatedSigma_le {ι Ω E : Type*} [MeasurableSpace Ω] [MeasurableSpace E]
    (X : ι → Ω → E) (s : Set ι) (hX : ∀ i ∈ s, Measurable (X i)) :
    generatedSigma X s ≤ (inferInstance : MeasurableSpace Ω) :=
  iSup_le (fun i ↦ (hX i i.property).comap_le)

/-- A measurable coordinatewise transformation can only reduce the generated sigma-algebra. -/
theorem generatedSigma_comp_le {ι Ω E F : Type*} [MeasurableSpace E] [MeasurableSpace F]
    (X : ι → Ω → E) (g : E → F) (hg : Measurable g) (s : Set ι) :
    generatedSigma (fun i ω ↦ g (X i ω)) s ≤ generatedSigma X s := by
  apply iSup_le
  intro i
  exact (MeasurableSpace.comap_le_comap_of_eq_comp g hg rfl).trans
    (comap_le_generatedSigma X i.property)

/-- Deterministic coordinates generate only the trivial sigma-algebra. -/
theorem generatedSigma_const {ι Ω E : Type*} [MeasurableSpace E]
    (x : ι → E) (s : Set ι) : generatedSigma (fun i (_ : Ω) ↦ x i) s = ⊥ := by
  simp [generatedSigma]

/-- Extend a row indexed by `0,...,N` by the fixed value `xStar` outside that interval. -/
def constantExtension {N : ℕ} {Ω E : Type*} (X : Fin (N + 1) → Ω → E)
    (xStar : E) (i : ℤ) (ω : Ω) : E :=
  if hi : 0 ≤ i ∧ i < (N + 1 : ℤ) then X ⟨i.toNat, by omega⟩ ω else xStar

/-- At an in-range time, constant extension agrees with the original finite coordinate. -/
theorem constantExtension_apply {N : ℕ} {Ω E : Type*}
    (X : Fin (N + 1) → Ω → E) (xStar : E) (i : Fin (N + 1)) (ω : Ω) :
    constantExtension X xStar (i : ℤ) ω = X i ω := by
  have hlt : (i : ℤ) < (N + 1 : ℤ) := by exact_mod_cast i.isLt
  simp [constantExtension, hlt]

end StrongMixing
