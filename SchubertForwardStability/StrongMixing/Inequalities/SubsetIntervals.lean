import SchubertForwardStability.StrongMixing.Inequalities.IntervalLaplace

/-!
# Coordinatewise maps and subset interval estimates

Measurable maps may vary with the coordinate and still contract every lag
coefficient. Zeroing coordinates outside a finite set therefore transfers the
second-moment and short-interval Laplace bounds to arbitrary subsets.
-/

open MeasureTheory ProbabilityTheory
open scoped BigOperators

namespace StrongMixing

/-- A family of measurable maps, one at each coordinate, contracts the sigma
field generated by any chosen coordinate set. The maps need not be identical. -/
theorem generatedSigma_family_comp_le {ι Ω E F : Type*}
    [MeasurableSpace E] [MeasurableSpace F] (X : ι → Ω → E) (g : ι → E → F)
    (hg : ∀ i, Measurable (g i)) (s : Set ι) :
    generatedSigma (fun i ω => g i (X i ω)) s ≤ generatedSigma X s := by
  apply iSup_le
  intro i
  exact (MeasurableSpace.comap_le_comap_of_eq_comp (g i) (hg i) rfl).trans
    (comap_le_generatedSigma X i.property)

/-- Applying a coordinate-dependent measurable map contracts each past/future
lag coefficient on an arbitrary probability space. -/
theorem mixingCoeff_family_comp_le {Ω E F : Type*} [MeasurableSpace Ω]
    [MeasurableSpace E] [MeasurableSpace F] (μ : Measure Ω) [IsProbabilityMeasure μ]
    (X : ℤ → Ω → E) (g : ℤ → E → F) (hg : ∀ i, Measurable (g i)) (h : ℕ) :
    mixingCoeff μ (fun i ω => g i (X i ω)) h ≤ mixingCoeff μ X h :=
  mixingCoeff_mono μ _ _ (fun s => generatedSigma_family_comp_le X g hg s) h

private theorem masked_interval_sum (X : ℤ → ℝ) (A : Finset ℤ) (a : ℤ) (n : ℕ)
    (hA : A ⊆ Finset.Ico a (a + n)) :
    (∑ i ∈ Finset.Ico a (a + n), if i ∈ A then X i else 0) = ∑ i ∈ A, X i := by
  classical
  have hs := Finset.sum_subset (f := fun i => if i ∈ A then X i else 0) hA
    (fun i _hi hnot => ite_eq_right hnot)
  calc
    _ = ∑ i ∈ A, if i ∈ A then X i else 0 := hs.symm
    _ = _ := Finset.sum_congr rfl (fun i hi => ite_eq_left hi)

private theorem masked_range_sum (X : ℤ → ℝ) (A : Finset ℤ) (a : ℤ) (n : ℕ)
    (hA : A ⊆ Finset.Ico a (a + n)) :
    (∑ k ∈ Finset.range n, if a + (k : ℤ) ∈ A then X (a + k) else 0) =
      ∑ i ∈ A, X i := by
  rw [← sum_int_interval_eq (fun i => if i ∈ A then X i else 0) a n]
  exact masked_interval_sum X A a n hA

variable {Ω : Type*} [MeasurableSpace Ω]

private theorem mask_properties (μ : Measure Ω) [IsProbabilityMeasure μ]
    (X : ℤ → Ω → ℝ) (hX : ∀ i, Measurable (X i))
    (hcenter : ∀ i, ∫ ω, X i ω ∂μ = 0) {M r : ℝ} (hM : 0 ≤ M)
    (hbound : ∀ i ω, |X i ω| ≤ M)
    (hmix : ∀ h : ℕ, 1 ≤ h → mixingCoeff μ X h ≤ r ^ h) (A : Finset ℤ) :
    (∀ i, Measurable (fun ω => if i ∈ A then X i ω else 0)) ∧
    (∀ i, ∫ ω, (if i ∈ A then X i ω else 0) ∂μ = 0) ∧
    (∀ i ω, |if i ∈ A then X i ω else 0| ≤ M) ∧
    (∀ h : ℕ, 1 ≤ h →
      mixingCoeff μ (fun i ω => if i ∈ A then X i ω else 0) h ≤ r ^ h) := by
  classical
  have hg : ∀ i : ℤ, Measurable (fun x : ℝ => if i ∈ A then x else 0) := by
    intro i
    by_cases hi : i ∈ A
    · simp only [ite_eq_left hi]
      fun_prop
    · simp only [ite_eq_right hi]
      fun_prop
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro i
    exact (hg i).comp (hX i)
  · intro i
    by_cases hi : i ∈ A
    · simpa only [ite_eq_left hi] using hcenter i
    · simp only [ite_eq_right hi, integral_zero]
  · intro i ω
    by_cases hi : i ∈ A
    · simpa only [ite_eq_left hi] using hbound i ω
    · simpa only [ite_eq_right hi, abs_zero] using hM
  · intro h hh
    exact (mixingCoeff_family_comp_le μ X _ hg h).trans (hmix h hh)

/-- The second moment of a centered bounded sum over any finite subset of an
integer interval of length `n` is at most `n*M^2*(1+8*r/(1-r))` under the
positive-lag coefficient bound `alpha(h) <= r^h`, whatever the subset. -/
theorem subset_interval_second_moment_le (μ : Measure Ω) [IsProbabilityMeasure μ]
    (X : ℤ → Ω → ℝ) (hX : ∀ i, Measurable (X i))
    (hcenter : ∀ i, ∫ ω, X i ω ∂μ = 0) {M r : ℝ} (hM : 0 ≤ M)
    (hbound : ∀ i ω, |X i ω| ≤ M) (hr0 : 0 ≤ r) (hr1 : r < 1)
    (hmix : ∀ h : ℕ, 1 ≤ h → mixingCoeff μ X h ≤ r ^ h)
    (A : Finset ℤ) (a : ℤ) (n : ℕ) (hA : A ⊆ Finset.Ico a (a + n)) :
    (∫ ω, (∑ i ∈ A, X i ω) ^ 2 ∂μ) ≤ n * M ^ 2 * (1 + 8 * r / (1 - r)) := by
  classical
  obtain ⟨hy, hc, hb, hm⟩ := mask_properties μ X hX hcenter hM hbound hmix A
  have h := interval_second_moment_le μ (fun i ω => if i ∈ A then X i ω else 0)
    hy hc hM hb hr0 hr1 hm a n
  have hs (ω : Ω) := masked_range_sum (fun i => X i ω) A a n hA
  change (∫ ω, (∑ k ∈ Finset.range n,
    if a + (k : ℤ) ∈ A then X (a + k) ω else 0) ^ 2 ∂μ) ≤ _ at h
  simp_rw [hs] at h
  exact h

/-- For any finite subset of an integer interval of length `n`, the centered
bounded log-Laplace transform has the same quadratic interval bound whenever
`|t|*n*M <= 1`. Empty subsets, zero bounds, and negative parameters are included. -/
theorem subset_interval_laplace_le (μ : Measure Ω) [IsProbabilityMeasure μ]
    (X : ℤ → Ω → ℝ) (hX : ∀ i, Measurable (X i))
    (hcenter : ∀ i, ∫ ω, X i ω ∂μ = 0) {M r : ℝ} (hM : 0 ≤ M)
    (hbound : ∀ i ω, |X i ω| ≤ M) (hr0 : 0 ≤ r) (hr1 : r < 1)
    (hmix : ∀ h : ℕ, 1 ≤ h → mixingCoeff μ X h ≤ r ^ h)
    (A : Finset ℤ) (a : ℤ) (n : ℕ) (hA : A ⊆ Finset.Ico a (a + n))
    (t : ℝ) (hsmall : |t| * n * M ≤ 1) :
    Real.log (∫ ω, Real.exp (t * ∑ i ∈ A, X i ω) ∂μ) ≤
      t ^ 2 * n * M ^ 2 * (1 + 8 * r / (1 - r)) := by
  classical
  obtain ⟨hy, hc, hb, hm⟩ := mask_properties μ X hX hcenter hM hbound hmix A
  have h := interval_log_laplace_le μ (fun i ω => if i ∈ A then X i ω else 0)
    hy hc hM hb hr0 hr1 hm a n t hsmall
  simp_rw [masked_interval_sum _ A a n hA] at h
  exact h

end StrongMixing
