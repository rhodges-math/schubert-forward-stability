import SchubertForwardStability.StrongMixing.Inequalities.UnitCovariance
import Mathlib.Algebra.Order.BigOperators.GroupWithZero.Finset

/-!
# Finite Ibragimov product decoupling

The discrepancy between an expectation of a finite product and the product of its
expectations is accumulated one factor at a time, using sigma-field covariance
estimates.

## References

* I. A. Ibragimov, *Some limit theorems for stationary processes*, Theory Probab. Appl. 7
  (1962), 349-382.
* F. Merlevède, M. Peligrad and E. Rio, *Bernstein inequality and moderate deviations under
  strong mixing conditions*, High dimensional probability V: the Luminy volume, Inst. Math.
  Stat. (IMS) Collect. 5 (2009), 273-292, arXiv:1202.4777, the lemma of Ibragimov in the
  Appendix.
-/

open MeasureTheory ProbabilityTheory
open scoped BigOperators

namespace StrongMixing

variable {Ω ι : Type*} [mΩ : MeasurableSpace Ω]

omit mΩ in
/-- A finite product of selected real coordinates is measurable in any sigma field
generated by a coordinate collection containing its finite index set. -/
theorem measurable_prod_generated (X : ι → Ω → ℝ) (A : Finset ι) (s : Set ι)
    (hA : ∀ i ∈ A, i ∈ s) :
    @Measurable Ω ℝ (generatedSigma X s) _ (fun ω => ∏ i ∈ A, X i ω) := by
  let : MeasurableSpace Ω := generatedSigma X s
  exact A.measurable_prod (fun i hi =>
    Measurable.of_comap_le (comap_le_generatedSigma X (hA i hi)))

omit mΩ in
private theorem prod_unit_nonneg (X : ι → Ω → ℝ) (A : Finset ι)
    (h0 : ∀ i ω, 0 ≤ X i ω) (ω : Ω) : 0 ≤ ∏ i ∈ A, X i ω :=
  Finset.prod_nonneg (fun i _ => h0 i ω)

omit mΩ in
private theorem prod_unit_le_one (X : ι → Ω → ℝ) (A : Finset ι)
    (h0 : ∀ i ω, 0 ≤ X i ω) (h1 : ∀ i ω, X i ω ≤ 1) (ω : Ω) :
    (∏ i ∈ A, X i ω) ≤ 1 := by
  simpa using Finset.prod_le_prod₀ (fun i _ => h0 i ω) (fun i _ => h1 i ω)

/-- For unit-interval real coordinates, each prefix-to-next-coordinate mixing
coefficient bounded by `a` gives the exact `(p - 1) * a` discrepancy for a product
of `p = n + 1` factors. This estimate includes the single-factor boundary `n = 0`. -/
theorem unit_product_error_le (μ : Measure Ω) [IsProbabilityMeasure μ]
    (X : ℕ → Ω → ℝ) (hX : ∀ i, Measurable (X i))
    (h0 : ∀ i ω, 0 ≤ X i ω) (h1 : ∀ i ω, X i ω ≤ 1) {a : ℝ}
    (ha : 0 ≤ a) (n : ℕ)
    (hcut : ∀ k, 1 ≤ k → k ≤ n →
      strongMixingCoeff (mΩ := mΩ) μ (generatedSigma X {i | i < k})
        (generatedSigma X {k}) ≤ a) :
    |(∫ ω, ∏ i ∈ Finset.range (n + 1), X i ω ∂μ) -
      ∏ i ∈ Finset.range (n + 1), (∫ ω, X i ω ∂μ)| ≤ (n : ℝ) * a := by
  have hI : ∀ i, Integrable (X i) μ := fun i =>
    (MemLp.of_bound (p := 1) (hX i).aestronglyMeasurable 1
      (Filter.Eventually.of_forall (fun ω => by
        simpa [Real.norm_eq_abs, abs_of_nonneg (h0 i ω)] using h1 i ω))).integrable le_rfl
  have hE0 : ∀ i, 0 ≤ ∫ ω, X i ω ∂μ := fun i => integral_nonneg (h0 i)
  have hE1 : ∀ i, (∫ ω, X i ω ∂μ) ≤ 1 := by
    intro i
    simpa using integral_mono (hI i) (integrable_const 1) (h1 i)
  induction n with
  | zero => simp
  | succ n ih =>
    let P : Ω → ℝ := fun ω => ∏ i ∈ Finset.range (n + 1), X i ω
    let Q : ℝ := ∏ i ∈ Finset.range (n + 1), (∫ ω, X i ω ∂μ)
    let F := generatedSigma X {i | i < n + 1}
    let G := generatedSigma X {n + 1}
    let : MeasurableSpace Ω := mΩ
    have hF : F ≤ mΩ := generatedSigma_le X _ (fun i _ => hX i)
    have hG : G ≤ mΩ := generatedSigma_le X _ (fun i _ => hX i)
    have hP : @Measurable Ω ℝ F _ P :=
      measurable_prod_generated X _ _ (fun _ hi => Finset.mem_range.mp hi)
    have hlast : @Measurable Ω ℝ G _ (X (n + 1)) :=
      Measurable.of_comap_le (comap_le_generatedSigma X (by simp))
    have hc := (unit_covariance_le μ F G hF hG P (X (n + 1)) hP hlast
      (prod_unit_nonneg X _ h0) (prod_unit_le_one X _ h0 h1)
      (h0 (n + 1)) (h1 (n + 1))).trans (hcut (n + 1) (by omega) le_rfl)
    have he := hE1 (n + 1)
    have he0 := hE0 (n + 1)
    have hstep :
        |(∫ ω, P ω * X (n + 1) ω ∂μ) - Q * (∫ ω, X (n + 1) ω ∂μ)| ≤
          a + (n : ℝ) * a := by
      calc
        _ = |((∫ ω, P ω * X (n + 1) ω ∂μ) -
            (∫ ω, P ω ∂μ) * (∫ ω, X (n + 1) ω ∂μ)) +
            ((∫ ω, P ω ∂μ) - Q) * (∫ ω, X (n + 1) ω ∂μ)| := by
              congr 1
              ring
        _ ≤ |(∫ ω, P ω * X (n + 1) ω ∂μ) -
              (∫ ω, P ω ∂μ) * (∫ ω, X (n + 1) ω ∂μ)| +
              |((∫ ω, P ω ∂μ) - Q) * (∫ ω, X (n + 1) ω ∂μ)| := abs_add_le _ _
        _ ≤ a + (n : ℝ) * a := by
          refine add_le_add hc ?_
          rw [abs_mul, abs_of_nonneg he0]
          have hprev := ih (fun k hk hkn => hcut k hk (hkn.trans (Nat.le_succ n)))
          exact (mul_le_mul_of_nonneg_right hprev he0).trans
            (mul_le_of_le_one_right (mul_nonneg (Nat.cast_nonneg _) ha) he)
    convert hstep using 1
    · simp only [P, Q, Finset.prod_range_succ]
    · simp only [Nat.cast_add, Nat.cast_one]
      ring

/-- Nonnegative bounded real coordinates satisfy the sharp finite Ibragimov
discrepancy bound `n * a * product M` for `n + 1` factors. Bounds may vary by
coordinate and may vanish. Only the prefix cuts of this finite product need
the coefficient bound `a`. -/
theorem bounded_product_error_le (μ : Measure Ω) [IsProbabilityMeasure μ]
    (X : ℕ → Ω → ℝ) (hX : ∀ i, Measurable (X i)) (M : ℕ → ℝ)
    (hM : ∀ i, 0 ≤ M i) (h0 : ∀ i ω, 0 ≤ X i ω)
    (hbound : ∀ i ω, X i ω ≤ M i) {a : ℝ} (ha : 0 ≤ a) (n : ℕ)
    (hcut : ∀ k, 1 ≤ k → k ≤ n →
      strongMixingCoeff (mΩ := mΩ) μ (generatedSigma X {i | i < k})
        (generatedSigma X {k}) ≤ a) :
    |(∫ ω, ∏ i ∈ Finset.range (n + 1), X i ω ∂μ) -
      ∏ i ∈ Finset.range (n + 1), (∫ ω, X i ω ∂μ)| ≤
        (n : ℝ) * a * ∏ i ∈ Finset.range (n + 1), M i := by
  classical
  by_cases hz : ∃ j ∈ Finset.range (n + 1), M j = 0
  · obtain ⟨j, hj, hMj⟩ := hz
    have hZj : X j = 0 := by
      funext ω
      exact le_antisymm (by simpa [hMj] using hbound j ω) (h0 j ω)
    have hP : ∀ ω, (∏ i ∈ Finset.range (n + 1), X i ω) = 0 := by
      intro ω
      exact Finset.prod_eq_zero_iff.mpr ⟨j, hj, by simp [hZj]⟩
    have hE : (∏ i ∈ Finset.range (n + 1), (∫ ω, X i ω ∂μ)) = 0 :=
      Finset.prod_eq_zero_iff.mpr ⟨j, hj, by simp [hZj]⟩
    have hPM : (∏ i ∈ Finset.range (n + 1), M i) = 0 :=
      Finset.prod_eq_zero_iff.mpr ⟨j, hj, hMj⟩
    simp [hP, hE, hPM]
  have hpos : ∀ i ∈ Finset.range (n + 1), 0 < M i := by
    intro i hi
    exact lt_of_le_of_ne (hM i) (Ne.symm (fun he => hz ⟨i, hi, he⟩))
  let Y : ℕ → Ω → ℝ := fun i ω => if i < n + 1 then X i ω / M i else 0
  have hY : ∀ i, Measurable (Y i) := by
    intro i
    dsimp [Y]
    split_ifs
    · exact (hX i).div_const _
    · exact measurable_const
  have hY0 : ∀ i ω, 0 ≤ Y i ω := by
    intro i ω
    dsimp [Y]
    split_ifs
    · exact div_nonneg (h0 i ω) (hM i)
    · exact le_rfl
  have hY1 : ∀ i ω, Y i ω ≤ 1 := by
    intro i ω
    dsimp [Y]
    split_ifs with hi
    · exact (div_le_one (hpos i (Finset.mem_range.mpr hi))).mpr (hbound i ω)
    · norm_num
  have hYS : ∀ s, generatedSigma Y s ≤ generatedSigma X s := by
    intro s
    let : MeasurableSpace Ω := generatedSigma X s
    apply generatedSigma_le
    intro i hi
    dsimp [Y]
    split_ifs
    · exact (Measurable.of_comap_le (comap_le_generatedSigma X hi)).div_const _
    · exact measurable_const
  have hCY : ∀ k, 1 ≤ k → k ≤ n →
      strongMixingCoeff (mΩ := mΩ) μ (generatedSigma Y {i | i < k})
        (generatedSigma Y {k}) ≤ a := by
    intro k hk hkn
    exact (strongMixingCoeff_mono μ (hYS _) (hYS _)).trans (hcut k hk hkn)
  have hu := unit_product_error_le μ Y hY hY0 hY1 ha n hCY
  have hXY : ∀ i ∈ Finset.range (n + 1), ∀ ω, X i ω = M i * Y i ω := by
    intro i hi ω
    dsimp [Y]
    rw [ite_eq_left (Finset.mem_range.mp hi)]
    field_simp [(hpos i hi).ne']
  have hProd : ∀ ω, (∏ i ∈ Finset.range (n + 1), X i ω) =
      (∏ i ∈ Finset.range (n + 1), M i) * ∏ i ∈ Finset.range (n + 1), Y i ω := by
    intro ω
    rw [← Finset.prod_mul_distrib]
    exact Finset.prod_congr rfl (fun i hi => hXY i hi ω)
  have hEx : (∏ i ∈ Finset.range (n + 1), (∫ ω, X i ω ∂μ)) =
      (∏ i ∈ Finset.range (n + 1), M i) *
        ∏ i ∈ Finset.range (n + 1), (∫ ω, Y i ω ∂μ) := by
    rw [← Finset.prod_mul_distrib]
    apply Finset.prod_congr rfl
    intro i hi
    rw [← integral_const_mul]
    exact integral_congr_ae (Filter.Eventually.of_forall (hXY i hi))
  have hprodM : 0 ≤ ∏ i ∈ Finset.range (n + 1), M i :=
    Finset.prod_nonneg (fun i _ => hM i)
  simp_rw [hProd]
  rw [integral_const_mul, hEx, ← mul_sub, abs_mul, abs_of_nonneg hprodM]
  exact (mul_le_mul_of_nonneg_left hu hprodM).trans_eq (by ring)

/-- The finite Ibragimov inequality in prefix-versus-future form: the discrepancy
for `p` nonnegative bounded factors is at most `(p - 1) * a * product M` when each
nontrivial prefix/future strong-mixing coefficient is at most `a`. The empty and
single-factor cases and zero coordinate bounds are included explicitly. -/
theorem nonnegative_product_error_le (μ : Measure Ω) [IsProbabilityMeasure μ]
    (X : ℕ → Ω → ℝ) (hX : ∀ i, Measurable (X i)) (M : ℕ → ℝ)
    (hM : ∀ i, 0 ≤ M i) (h0 : ∀ i ω, 0 ≤ X i ω)
    (hbound : ∀ i ω, X i ω ≤ M i) {a : ℝ} (ha : 0 ≤ a) (p : ℕ)
    (hcut : ∀ k, 1 ≤ k → k < p →
      strongMixingCoeff (mΩ := mΩ) μ (generatedSigma X {i | i < k})
        (generatedSigma X {i | k ≤ i ∧ i < p}) ≤ a) :
    |(∫ ω, ∏ i ∈ Finset.range p, X i ω ∂μ) -
      ∏ i ∈ Finset.range p, (∫ ω, X i ω ∂μ)| ≤
        ((p - 1 : ℕ) : ℝ) * a * ∏ i ∈ Finset.range p, M i := by
  cases p with
  | zero => simp
  | succ n =>
    apply bounded_product_error_le μ X hX M hM h0 hbound ha n
    intro k hk hkn
    have hG : generatedSigma X {k} ≤
        generatedSigma X {i | k ≤ i ∧ i < n + 1} := by
      apply generatedSigma_mono
      intro i hi
      simp only [Set.mem_singleton_iff] at hi
      subst i
      exact ⟨le_rfl, by omega⟩
    exact (strongMixingCoeff_mono μ le_rfl hG).trans (hcut k hk (by omega))

end StrongMixing
