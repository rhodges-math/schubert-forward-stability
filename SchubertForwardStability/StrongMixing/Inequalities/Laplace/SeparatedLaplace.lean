import SchubertForwardStability.StrongMixing.Inequalities.Laplace.PositiveLaplace
import SchubertForwardStability.StrongMixing.Coefficients.CoefficientBounds

/-! # Laplace errors across separated blocks

Finite sums over past and future coordinate collections are measurable for the
corresponding generated sigma-algebras. The exponential covariance estimate
therefore controls their product-approximation error by the sequence mixing coefficient.
-/

open MeasureTheory
open scoped BigOperators

namespace StrongMixing

variable {Ω : Type*} [mΩ : MeasurableSpace Ω]

omit mΩ in
/-- A finite sum of selected coordinates is measurable for the sigma-algebra
generated by any coordinate collection containing its index set. -/
theorem measurable_sum_generated {ι : Type*} (X : ι → Ω → ℝ)
    (A : Finset ι) (s : Set ι) (hs : ∀ i ∈ A, i ∈ s) :
    @Measurable Ω ℝ (generatedSigma X s) inferInstance (fun ω ↦ ∑ i ∈ A, X i ω) := by
  let : MeasurableSpace Ω := generatedSigma X s
  exact A.measurable_sum fun i hi ↦
    Measurable.of_comap_le (comap_le_generatedSigma X (hs i hi))

omit mΩ in
/-- A sum of uniformly bounded real coordinates is bounded by the number of
summands times the coordinate bound; the empty block is included. -/
theorem abs_sum_le_card_mul {ι : Type*} (X : ι → Ω → ℝ) (A : Finset ι)
    {M : ℝ} (hX : ∀ i ∈ A, ∀ ω, |X i ω| ≤ M) (ω : Ω) :
    |∑ i ∈ A, X i ω| ≤ (A.card : ℝ) * M := by
  calc
    _ ≤ ∑ i ∈ A, |X i ω| := Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _i ∈ A, M := Finset.sum_le_sum fun i hi ↦ hX i hi ω
    _ = _ := by simp

/-- The Laplace product error of two uniformly bounded finite blocks separated by
a natural lag is at most their exponential size bound times the lag mixing coefficient.
Empty blocks, zero lag and negative Laplace parameters are allowed. -/
theorem separated_laplace_error_le (μ : Measure Ω) [IsProbabilityMeasure μ]
    (X : ℤ → Ω → ℝ) (hX : ∀ i, Measurable (X i)) (A B : Finset ℤ)
    (k : ℤ) (h : ℕ) (hA : ∀ i ∈ A, i ≤ k) (hB : ∀ i ∈ B, k + (h : ℤ) ≤ i)
    {M : ℝ} (hM : ∀ i, ∀ ω, |X i ω| ≤ M) (t : ℝ) :
    |(∫ ω, Real.exp (t * ((∑ i ∈ A, X i ω) + ∑ i ∈ B, X i ω)) ∂μ) -
      (∫ ω, Real.exp (t * ∑ i ∈ A, X i ω) ∂μ) *
        ∫ ω, Real.exp (t * ∑ i ∈ B, X i ω) ∂μ| ≤
      Real.exp (|t| * (M * ((A.card : ℝ) + B.card))) * mixingCoeff μ X h := by
  have hp := laplace_product_error_le μ
    (generatedSigma X {i | i ≤ k}) (generatedSigma X {i | k + (h : ℤ) ≤ i})
    (generatedSigma_le X _ (fun i _ ↦ hX i))
    (generatedSigma_le X _ (fun i _ ↦ hX i))
    (fun ω ↦ ∑ i ∈ A, X i ω) (fun ω ↦ ∑ i ∈ B, X i ω)
    (measurable_sum_generated X A _ hA) (measurable_sum_generated X B _ hB)
    (abs_sum_le_card_mul X A (fun i _ ↦ hM i))
    (abs_sum_le_card_mul X B (fun i _ ↦ hM i)) t
  have he : (A.card : ℝ) * M + (B.card : ℝ) * M =
      M * ((A.card : ℝ) + B.card) := by ring
  rw [he] at hp
  exact hp.trans (mul_le_mul_of_nonneg_left (cutCoeff_le_mixingCoeff μ X h k)
    (Real.exp_pos _).le)

/-- Under the concrete exponential lag bound, separated bounded blocks have
Laplace product error controlled by one exponential combining block size and gap decay. -/
theorem geometric_laplace_error_le (μ : Measure Ω) [IsProbabilityMeasure μ]
    (X : ℤ → Ω → ℝ) (hX : ∀ i, Measurable (X i)) (A B : Finset ℤ)
    (k : ℤ) (h : ℕ) (hA : ∀ i ∈ A, i ≤ k) (hB : ∀ i ∈ B, k + (h : ℤ) ≤ i)
    {M c : ℝ} (hM : ∀ i, ∀ ω, |X i ω| ≤ M)
    (hc : mixingCoeff μ X h ≤ Real.exp (-2 * c * h)) (t : ℝ) :
    |(∫ ω, Real.exp (t * ((∑ i ∈ A, X i ω) + ∑ i ∈ B, X i ω)) ∂μ) -
      (∫ ω, Real.exp (t * ∑ i ∈ A, X i ω) ∂μ) *
        ∫ ω, Real.exp (t * ∑ i ∈ B, X i ω) ∂μ| ≤
      Real.exp (|t| * (M * ((A.card : ℝ) + B.card)) - 2 * c * h) := by
  have hp := separated_laplace_error_le μ X hX A B k h hA hB hM t
  have hb := hp.trans (mul_le_mul_of_nonneg_left hc (Real.exp_pos _).le)
  simpa only [sub_eq_add_neg, ← Real.exp_add, neg_mul] using hb

end StrongMixing
