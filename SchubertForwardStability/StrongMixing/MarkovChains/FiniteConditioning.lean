import SchubertForwardStability.StrongMixing.MarkovChains.TwoStateExpectations
import SchubertForwardStability.StrongMixing.Coefficients.Atoms
import Mathlib.MeasureTheory.Measure.Real
import Mathlib.Tactic

/-! # Finite conditioning and past-event discrepancies

A measurable finite-valued history partitions the sample space into fibers.
Conditional future-event probabilities with bounded oscillation give the same
bound for every event generated by the history. The conditional probabilities are
computed on the atoms of the history.
-/

open MeasureTheory
open scoped BigOperators

namespace StrongMixing

variable {Ω E : Type*} [mΩ : MeasurableSpace Ω] [MeasurableSpace E]
    [MeasurableSingletonClass E] [Fintype E]
    (μ : Measure Ω) [IsProbabilityMeasure μ]

/-- The probability of an ambient-measurable event is the sum of its intersections
with the fibers of a measurable finite-valued coordinate. -/
theorem measureReal_finite_fibers (f : Ω → E) (hf : Measurable f)
    {A : Set Ω} (hA : MeasurableSet A) :
    μ.real A = ∑ u : E, μ.real ({ω | f ω = u} ∩ A) := by
  classical
  have he : A = ⋃ u : E, {ω | f ω = u} ∩ A := by
    ext ω
    simp only [Set.mem_iUnion, Set.mem_inter_iff, Set.mem_ofPred_eq]
    exact ⟨fun h => ⟨f ω, rfl, h⟩, fun ⟨_, _, h⟩ => h⟩
  conv_lhs => rw [he]
  apply measureReal_iUnion_fintype
  · intro u v huv
    change Disjoint ({ω | f ω = u} ∩ A) ({ω | f ω = v} ∩ A)
    rw [Set.disjoint_left]
    intro ω hu hv
    exact huv (hu.1.symm.trans hv.1)
  · intro u
    exact (hf (measurableSet_singleton u)).inter hA
  · intro u
    exact measure_ne_top μ _

/-- The probabilities of all fibers of a measurable finite-valued coordinate add
to one on a probability space, including fibers with zero probability. -/
theorem finite_fiber_prob_sum (f : Ω → E) (hf : Measurable f) :
    ∑ u : E, μ.real {ω | f ω = u} = 1 := by
  simpa using (measureReal_finite_fibers μ f hf MeasurableSet.univ).symm

/-- If conditional probabilities of an ambient-measurable future event have
oscillation at most `L` across a finite measurable history's fibers, then every
event determined by that history has discrepancy at most `L` from the future
event. The factorization hypothesis is stated for the probabilities of the atoms. -/
theorem finite_conditioning_discrepancy (f : Ω → E) (hf : Measurable f)
    {A B : Set Ω} (hA : MeasurableSet[MeasurableSpace.comap f inferInstance] A)
    (hB : MeasurableSet B) (q : E → ℝ) {L : ℝ} (hL : 0 ≤ L)
    (hcond : ∀ u, μ.real ({ω | f ω = u} ∩ B) = μ.real {ω | f ω = u} * q u)
    (hq : ∀ u v, |q u - q v| ≤ L) :
    |μ.real (A ∩ B) - μ.real A * μ.real B| ≤ L := by
  classical
  have hAm : MeasurableSet A := hf.comap_le _ hA
  obtain ⟨D, _, hD⟩ := MeasurableSpace.measurableSet_comap.mp hA
  let p : E → ℝ := fun u => μ.real {ω | f ω = u}
  have hp : ∀ u, 0 ≤ p u := fun _ => measureReal_nonneg
  have hs : ∑ u, p u = 1 := finite_fiber_prob_sum μ f hf
  have hmean : μ.real B = ∑ u, p u * q u := by
    rw [measureReal_finite_fibers μ f hf hB]
    exact Finset.sum_congr rfl (fun u _ => hcond u)
  have hosc (u : E) : |q u - μ.real B| ≤ L := by
    rw [hmean]
    exact probability_mean_oscillation p q hp hs L hq u
  rw [measureReal_finite_fibers μ f hf (hAm.inter hB),
    measureReal_finite_fibers μ f hf hAm, Finset.sum_mul, ← Finset.sum_sub_distrib]
  calc
    _ ≤ ∑ u : E, |μ.real ({ω | f ω = u} ∩ (A ∩ B)) -
        μ.real ({ω | f ω = u} ∩ A) * μ.real B| := Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ u : E, p u * L := by
      apply Finset.sum_le_sum
      intro u _
      by_cases hu : u ∈ D
      · have heA : {ω | f ω = u} ∩ A = {ω | f ω = u} := by
          ext ω
          rw [← hD]
          simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_ofPred_eq]
          constructor
          · exact And.left
          · intro he
            exact ⟨he, he ▸ hu⟩
        have heAB : {ω | f ω = u} ∩ (A ∩ B) = {ω | f ω = u} ∩ B := by
          rw [← Set.inter_assoc, heA]
        rw [heAB, heA, hcond u, ← mul_sub, abs_mul, abs_of_nonneg (hp u)]
        exact mul_le_mul_of_nonneg_left (hosc u) (hp u)
      · have heA : {ω | f ω = u} ∩ A = ∅ := by
          ext ω
          rw [← hD]
          simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_ofPred_eq,
            Set.mem_empty_iff_false, iff_false, not_and]
          intro he
          simpa only [he] using hu
        have heAB : {ω | f ω = u} ∩ (A ∩ B) = ∅ := by
          rw [← Set.inter_assoc, heA, Set.empty_inter]
        rw [heAB, heA]
        simpa using mul_nonneg (hp u) hL
    _ = L := by rw [← Finset.sum_mul, hs, one_mul]

end StrongMixing
