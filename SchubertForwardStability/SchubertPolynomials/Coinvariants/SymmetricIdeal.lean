import Mathlib.RingTheory.MvPolynomial.Symmetric.FundamentalTheorem
import Mathlib.RingTheory.Ideal.Span

/-! # Symmetric generators of the coinvariant ideal

The ideal generated by symmetric polynomials with zero constant coefficient is
the ideal generated by the elementary symmetric polynomials of positive degree.
Both presentations are over an arbitrary commutative coefficient ring.

## References

* I. G. Macdonald, *Notes on Schubert polynomials*, Chapter IV.
-/

namespace SchubertPolynomial

noncomputable section

open MvPolynomial
open scoped Classical

variable {R : Type*} [CommRing R]

/-- The ideal generated by symmetric polynomials with zero constant coefficient. -/
def symmetricIdeal (R : Type*) [CommRing R] (n : ℕ) : Ideal (MvPolynomial (Fin n) R) :=
  Ideal.span {p | p.IsSymmetric ∧ constantCoeff p = 0}

/-- The ideal generated by the elementary symmetric polynomials of degrees one through n. -/
def elementaryIdeal (R : Type*) [CommRing R] (n : ℕ) : Ideal (MvPolynomial (Fin n) R) :=
  Ideal.span (Set.range fun i : Fin n => esymm (Fin n) R ((i : ℕ) + 1))

/-- Every positive-degree elementary symmetric polynomial has zero constant coefficient. -/
theorem constantCoeff_esymm_pos {n k : ℕ} (hk : 0 < k) :
    constantCoeff (esymm (Fin n) R k) = 0 := by
  rw [esymm]
  simp only [map_sum, map_prod, constantCoeff_X]
  apply Finset.sum_eq_zero
  intro t ht
  have htne : t.Nonempty := Finset.card_pos.mp (by
    rw [(Finset.mem_powersetCard.mp ht).2]
    exact hk)
  exact Finset.prod_eq_zero htne.choose_spec rfl

private theorem elementary_eval_constant (n : ℕ) (q : MvPolynomial (Fin n) R) :
    constantCoeff (aeval (fun i : Fin n => esymm (Fin n) R ((i : ℕ) + 1)) q) =
      constantCoeff q := by
  induction q using MvPolynomial.induction_on with
  | C r => simp
  | add p q hp hq => simp only [map_add, hp, hq]
  | mul_X p i _ =>
    simp only [map_mul, aeval_X, constantCoeff_X,
      constantCoeff_esymm_pos (Nat.succ_pos _), mul_zero]

private theorem elementary_eval_sub_constant (n : ℕ) (q : MvPolynomial (Fin n) R) :
    aeval (fun i : Fin n => esymm (Fin n) R ((i : ℕ) + 1)) q - C (constantCoeff q) ∈
      elementaryIdeal R n := by
  induction q using MvPolynomial.induction_on with
  | C r => simp
  | add p q hp hq =>
    simp only [map_add]
    convert (elementaryIdeal R n).add_mem hp hq using 1; ring
  | mul_X p i _ =>
    simp only [map_mul, aeval_X, constantCoeff_X, mul_zero, map_zero, sub_zero]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)

/-- The positive-degree symmetric ideal equals its elementary-generator presentation. -/
theorem symmetricIdeal_eq_elementary (n : ℕ) :
    symmetricIdeal R n = elementaryIdeal R n := by
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro p ⟨hp, hzero⟩
    obtain ⟨q, hq⟩ := (esymmAlgHom_fin_bijective R n).2 ⟨p, hp⟩
    have he := congrArg Subtype.val hq
    rw [esymmAlgHom_apply] at he
    have hc : constantCoeff q = 0 := by
      rw [←elementary_eval_constant n q, he, hzero]
    change p ∈ elementaryIdeal R n
    simpa only [he, hc, map_zero, sub_zero] using elementary_eval_sub_constant n q
  · apply Ideal.span_le.mpr
    rintro p ⟨i, rfl⟩
    exact Ideal.subset_span
      ⟨esymm_isSymmetric (Fin n) R _, constantCoeff_esymm_pos (Nat.succ_pos _)⟩

end

end SchubertPolynomial
