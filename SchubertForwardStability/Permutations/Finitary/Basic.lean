import Mathlib.GroupTheory.Perm.ClosureSwap

/-! # Finitely supported permutations

## Main definitions

* `FinitaryPerm`: the subgroup generated by transpositions.
* `FinitaryPerm.ofPerm`: a permutation with a proof of finite moved support.
* `FinitaryPerm.movedPoints`: the finite set of points not fixed by a permutation.

## Implementation notes

The carrier and group structure are Mathlib's swap closure. Decidable equality is
an explicit parameter. Multiplication is function composition, so multiplication
on the right by a transposition exchanges positions.
-/

/-- Permutations moving only finitely many points, represented by the subgroup
generated by transpositions. -/
abbrev FinitaryPerm (α : Type*) [DecidableEq α] :=
  ↥(Subgroup.closure {w : Equiv.Perm α | Equiv.Perm.IsSwap w})

namespace FinitaryPerm

variable {α : Type*} [DecidableEq α]

/-- A finitary permutation acts by its underlying equivalence. -/
instance : CoeFun (FinitaryPerm α) (fun _ => α → α) := ⟨fun w => w.val⟩

/-- Finitary permutations are equal when they agree at every point. -/
@[ext]
theorem ext {w v : FinitaryPerm α} (h : ∀ a, w a = v a) : w = v :=
  Subtype.ext (Equiv.ext h)

/-- The identity permutation fixes every point. -/
@[simp]
theorem one_apply (a : α) : (1 : FinitaryPerm α) a = a := rfl

/-- Multiplication composes the two underlying functions. -/
@[simp]
theorem mul_apply (w v : FinitaryPerm α) (a : α) : (w * v) a = w (v a) := rfl

/-- Applying a permutation and then its inverse returns the initial point. -/
theorem inv_apply_apply (w : FinitaryPerm α) (a : α) : w⁻¹ (w a) = a :=
  w.val.symm_apply_apply a

/-- Applying an inverse and then its permutation returns the initial point. -/
theorem apply_inv_apply (w : FinitaryPerm α) (a : α) : w (w⁻¹ a) = a :=
  w.val.apply_symm_apply a

/-- A finitary permutation acts injectively. -/
theorem injective (w : FinitaryPerm α) : Function.Injective w := w.val.injective

/-- A finitary permutation acts surjectively. -/
theorem surjective (w : FinitaryPerm α) : Function.Surjective w := w.val.surjective

/-- The set of moved points of a finitary permutation is finite. -/
theorem finite_movedSet (w : FinitaryPerm α) : {a | w a ≠ a}.Finite := by
  have h := mem_closure_isSwap'.mp w.property
  convert h using 1
  ext a
  simp only [Set.mem_ofPred_eq, Set.mem_compl_iff, MulAction.mem_fixedBy,
    Equiv.Perm.smul_def]

/-- Construct a finitary permutation from an equivalence with finite moved support. -/
def ofPerm (w : Equiv.Perm α) (h : {a | w a ≠ a}.Finite) : FinitaryPerm α := by
  refine ⟨w, mem_closure_isSwap'.mpr ?_⟩
  convert h using 1
  ext a
  simp only [Set.mem_ofPred_eq, Set.mem_compl_iff, MulAction.mem_fixedBy,
    Equiv.Perm.smul_def]

/-- The constructor acts by the supplied equivalence. -/
@[simp]
theorem ofPerm_apply (w : Equiv.Perm α) (h : {a | w a ≠ a}.Finite) (a : α) :
    ofPerm w h a = w a := rfl

/-- Constructing from the underlying equivalence returns the same finitary permutation. -/
@[simp]
theorem ofPerm_val (w : FinitaryPerm α) : ofPerm w.val w.finite_movedSet = w := rfl

noncomputable section

/-- The finite set of points not fixed by a finitary permutation. -/
def movedPoints (w : FinitaryPerm α) : Finset α := w.finite_movedSet.toFinset

/-- Membership in moved support is equivalent to not being fixed. -/
@[simp]
theorem mem_movedPoints (w : FinitaryPerm α) (a : α) :
    a ∈ w.movedPoints ↔ w a ≠ a := Set.Finite.mem_toFinset _

/-- The identity has empty moved support. -/
@[simp]
theorem movedPoints_one : movedPoints (1 : FinitaryPerm α) = ∅ := by
  ext a
  simp only [mem_movedPoints, one_apply, ne_eq, not_true_eq_false,
    Finset.notMem_empty]

/-- A finitary permutation has empty moved support exactly when it is the identity. -/
@[simp]
theorem movedPoints_eq_empty (w : FinitaryPerm α) : w.movedPoints = ∅ ↔ w = 1 := by
  constructor
  · intro h
    apply ext
    intro a
    have : a ∉ w.movedPoints := h ▸ Finset.notMem_empty a
    simpa only [mem_movedPoints, not_not, one_apply] using this
  · rintro rfl
    exact movedPoints_one

/-- Inversion does not change the moved support. -/
@[simp]
theorem movedPoints_inv (w : FinitaryPerm α) : movedPoints w⁻¹ = w.movedPoints := by
  ext a
  simp only [mem_movedPoints, ne_eq]
  have h : w⁻¹ a = a ↔ w a = a := by
    constructor
    · intro h
      have := congrArg w h
      simpa only [apply_inv_apply] using this.symm
    · intro h
      have := congrArg (fun b => w⁻¹ b) h
      simpa only [inv_apply_apply] using this.symm
  exact not_congr h

/-- The support of a product is contained in the union of the two moved supports. -/
theorem movedPoints_mul_subset (w v : FinitaryPerm α) :
    (w * v).movedPoints ⊆ w.movedPoints ∪ v.movedPoints := by
  intro a ha
  by_contra h
  have hw : w a = a := by
    simpa only [mem_movedPoints, not_not] using (Finset.notMem_union.mp h).1
  have hv : v a = a := by
    simpa only [mem_movedPoints, not_not] using (Finset.notMem_union.mp h).2
  exact (mem_movedPoints _ _).mp ha (by rw [mul_apply, hv, hw])

end

/-- The finitary transposition exchanging two points. -/
def swap (a b : α) : FinitaryPerm α := by
  refine ⟨Equiv.swap a b, ?_⟩
  by_cases h : a = b
  · subst b
    rw [Equiv.swap_self]
    change (1 : Equiv.Perm α) ∈ Subgroup.closure {w : Equiv.Perm α | w.IsSwap}
    exact Subgroup.one_mem _
  · exact Subgroup.subset_closure ⟨a, b, h, rfl⟩

/-- A transposition sends its first point to its second. -/
@[simp]
theorem swap_apply_left (a b : α) : swap a b a = b := Equiv.swap_apply_left a b

/-- A transposition sends its second point to its first. -/
@[simp]
theorem swap_apply_right (a b : α) : swap a b b = a := Equiv.swap_apply_right a b

/-- A transposition fixes points different from both exchanged points. -/
theorem swap_apply_of_ne {a b c : α} (ha : c ≠ a) (hb : c ≠ b) : swap a b c = c :=
  Equiv.swap_apply_of_ne_of_ne ha hb

/-- Exchanging a point with itself is the identity. -/
@[simp]
theorem swap_self (a : α) : swap a a = 1 := Subtype.ext (Equiv.swap_self a)

/-- A transposition is its own inverse. -/
@[simp]
theorem swap_inv (a b : α) : (swap a b)⁻¹ = swap a b := Subtype.ext (Equiv.swap_inv a b)

end FinitaryPerm
