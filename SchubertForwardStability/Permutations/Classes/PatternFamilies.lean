import SchubertForwardStability.Permutations.Classes.Patterns
import SchubertForwardStability.Permutations.Classes.Grassmannian
import SchubertForwardStability.Permutations.Classes.Boolean
import SchubertForwardStability.Permutations.Statistics.Descents

/-! # Finite combinatorial permutation families

## Main definitions

Named patterns, coGrassmannian and fireworks families, and the displayed
pattern-avoidance and parabolic criteria for the conjectural families.

## Implementation notes

All families are finite subsets of the explicitly bounded symmetric group.
Smoothness and Levi-sphericality use only their combinatorial descriptions.
-/

namespace PermutationPattern

/-- The pattern with one-line notation `132`. -/
def p132 : PermutationPattern 3 := Equiv.swap 1 2

/-- The pattern with one-line notation `231`. -/
def p231 : PermutationPattern 3 := Equiv.swap 0 1 * Equiv.swap 1 2

/-- The pattern with one-line notation `321`. -/
def p321 : PermutationPattern 3 := Equiv.swap 0 2

/-- The pattern with one-line notation `3412`. -/
def p3412 : PermutationPattern 4 := Equiv.swap 0 2 * Equiv.swap 1 3

/-- The pattern with one-line notation `4231`. -/
def p4231 : PermutationPattern 4 := Equiv.swap 0 3

/-- The pattern with one-line notation `2143`. -/
def p2143 : PermutationPattern 4 := Equiv.swap 0 1 * Equiv.swap 2 3

end PermutationPattern

namespace FinitaryPerm

open scoped Classical

/-- CoGrassmannian permutations have Grassmannian inverses. -/
noncomputable def coGrassmannian (n : ℕ) : Finset (FinitaryPerm ℕ+) :=
  (symmetricGroup n).filter fun w => w⁻¹ ∈ grassmannian n

/-- Membership in the coGrassmannian family means Grassmannian inverse membership. -/
@[simp]
theorem mem_coGrassmannian (n : ℕ) (w : FinitaryPerm ℕ+) :
    w ∈ coGrassmannian n ↔ IsSupported n w ∧ w⁻¹ ∈ grassmannian n := by
  simp only [coGrassmannian, Finset.mem_filter, mem_symmetricGroup]

/-- A decreasing run begins at the first position or just after an ascent. -/
def IsRunStart (n : ℕ) (w : FinitaryPerm ℕ+) (i : ℕ+) : Prop :=
  (i : ℕ) ≤ n ∧ (i = 1 ∨ ∃ j : ℕ+, j + 1 = i ∧ w j < w i)

/-- Fireworks permutations have increasing initial values of maximal decreasing runs. -/
def IsFireworks (n : ℕ) (w : FinitaryPerm ℕ+) : Prop :=
  ∀ i j, IsRunStart n w i → IsRunStart n w j → i < j → w i < w j

/-- The fireworks family in the first `n` positions. -/
noncomputable def fireworks (n : ℕ) : Finset (FinitaryPerm ℕ+) :=
  (symmetricGroup n).filter (IsFireworks n)

/-- Fireworks-family membership includes its ambient support bound. -/
@[simp]
theorem mem_fireworks (n : ℕ) (w : FinitaryPerm ℕ+) :
    w ∈ fireworks n ↔ IsSupported n w ∧ IsFireworks n w := by
  simp only [fireworks, Finset.mem_filter, mem_symmetricGroup]

/-- Smooth permutations are the simultaneous `3412`- and `4231`-avoiders. -/
noncomputable def smooth (n : ℕ) : Finset (FinitaryPerm ℕ+) :=
  PermutationPattern.avoidingMany n
    [⟨4, PermutationPattern.p3412⟩, ⟨4, PermutationPattern.p4231⟩]

/-- Vexillary permutations are the `2143`-avoiders. -/
noncomputable def vexillary (n : ℕ) : Finset (FinitaryPerm ℕ+) :=
  PermutationPattern.avoiding n PermutationPattern.p2143

/-- Covexillary permutations are the `3412`-avoiders. -/
noncomputable def covexillary (n : ℕ) : Finset (FinitaryPerm ℕ+) :=
  PermutationPattern.avoiding n PermutationPattern.p3412

/-- The inverse descents in the ambient simple-generator interval. -/
noncomputable def inverseDescents (n : ℕ) (w : FinitaryPerm ℕ+) : Finset ℕ+ :=
  (positions (n - 1)).filter fun i => w⁻¹ (i + 1) < w⁻¹ i

/-- The subgroup generated by a finite set of adjacent transpositions. -/
def simpleParabolic (I : Finset ℕ+) : Subgroup (FinitaryPerm ℕ+) :=
  Subgroup.closure (simpleTransposition '' (I : Set ℕ+))

/-- The finite ambient members of a simple parabolic subgroup. -/
noncomputable def parabolicMembers (n : ℕ) (I : Finset ℕ+) :
    Finset (FinitaryPerm ℕ+) :=
  (symmetricGroup n).filter fun v => v ∈ simpleParabolic I

/-- Finite parabolic membership combines support containment and subgroup membership. -/
@[simp]
theorem mem_parabolicMembers (n : ℕ) (I : Finset ℕ+) (v : FinitaryPerm ℕ+) :
    v ∈ parabolicMembers n I ↔ IsSupported n v ∧ v ∈ simpleParabolic I := by
  simp only [parabolicMembers, Finset.mem_filter, mem_symmetricGroup]

/-- Every finite ambient parabolic family contains identity. -/
theorem one_mem_parabolicMembers (n : ℕ) (I : Finset ℕ+) :
    (1 : FinitaryPerm ℕ+) ∈ parabolicMembers n I :=
  (mem_parabolicMembers n I 1).mpr ⟨isSupported_one n, (simpleParabolic I).one_mem⟩

/-- A parabolic longest element belongs to the subgroup and maximizes inversion length. -/
def IsParabolicLongest (n : ℕ) (I : Finset ℕ+) (v : FinitaryPerm ℕ+) : Prop :=
  v ∈ parabolicMembers n I ∧ ∀ x ∈ parabolicMembers n I, x.length ≤ v.length

/-- A finite ambient parabolic family has an element of greatest inversion length. -/
theorem exists_parabolicLongest (n : ℕ) (I : Finset ℕ+) :
    ∃ v, IsParabolicLongest n I v := by
  obtain ⟨v, hv, hmax⟩ := Finset.exists_mem_eq_sup (parabolicMembers n I)
    ⟨1, one_mem_parabolicMembers n I⟩ length
  refine ⟨v, hv, fun x hx => ?_⟩
  exact (Finset.le_sup (f := length) hx).trans_eq hmax

/-- The Levi-spherical combinatorial criterion uses the inverse-descent parabolic longest. -/
def IsLeviSpherical (n : ℕ) (w : FinitaryPerm ℕ+) : Prop :=
  ∃ v, IsParabolicLongest n (inverseDescents n w) v ∧ IsBoolean (v * w)

/-- The maximal Levi-spherical family defined by the displayed combinatorial criterion. -/
noncomputable def leviSpherical (n : ℕ) : Finset (FinitaryPerm ℕ+) :=
  (symmetricGroup n).filter (IsLeviSpherical n)

/-- Levi-spherical-family membership includes the support and parabolic criteria. -/
@[simp]
theorem mem_leviSpherical (n : ℕ) (w : FinitaryPerm ℕ+) :
    w ∈ leviSpherical n ↔ IsSupported n w ∧ IsLeviSpherical n w := by
  simp only [leviSpherical, Finset.mem_filter, mem_symmetricGroup]

end FinitaryPerm
